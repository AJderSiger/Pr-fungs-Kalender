// Prisma Schema – Prüfungsplaner
// Doku: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  // Mit engineType "client" übersetzt Prisma Abfragen selbst und braucht
  // keine plattformabhängige Query-Engine-Datei mehr (setzt einen Driver
  // Adapter voraus – siehe src/lib/prisma.ts). Ohne das schlägt der Betrieb
  // auf Netlify fehl, weil dort auf Debian gebaut und auf RHEL ausgeführt
  // wird und die erzeugte Datei deshalb nicht passt.
  engineType = "client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  TEACHER
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  displayName  String
  role         Role
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  exams Exam[] @relation("TeacherExams")

  @@map("users")
}

model Exam {
  id              String   @id @default(cuid())
  subject         String
  subjectCode     String
  date            DateTime @db.Date
  lessonStart     Int
  durationMinutes Int      @default(45)
  title           String
  description     String?
  examType        String?
  // Name der Fachlehrperson (unabhängig vom eingeloggten Account, da
  // mehrere Lehrpersonen sich einen Login teilen). Wird beim Erstellen aus
  // src/lib/config/teachers.ts vorgeschlagen und kann überschrieben werden.
  teacherName     String
  notes           String?
  teacherId       String
  teacher         User     @relation("TeacherExams", fields: [teacherId], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([date])
  @@index([teacherId])
  @@map("exams")
}
