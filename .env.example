# Verbindung zur zentralen PostgreSQL-Datenbank.
# Lokale Entwicklung: von `npx prisma dev` ausgegebene URL.
# Produktion: Connection-String eines gehosteten Postgres (z. B. Neon, Supabase, Vercel Postgres).
DATABASE_URL="postgresql://user:password@host:5432/datenbank?sslmode=require"

# Geheimer Schlüssel zum Signieren der Login-Sessions.
# Erzeugen mit: npx auth secret   (oder ein beliebiger zufälliger String, min. 32 Zeichen)
AUTH_SECRET="ersetze-mich-mit-einem-zufaelligen-geheimen-wert"

# Optional: Zugangsdaten beim Seeden (npm run db:seed) überschreiben.
# Ohne diese Variablen werden die Standardwerte aus der Aufgabenstellung verwendet
# (Benutzername "Schüler"/"Lehrer", Passwort "123456").
# SEED_STUDENT_USERNAME="Schüler"
# SEED_STUDENT_PASSWORD="123456"
# SEED_TEACHER_USERNAME="Lehrer"
# SEED_TEACHER_PASSWORD="123456"
